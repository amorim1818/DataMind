<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>DataMind - Enviar arquivo</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    ]<link rel="stylesheet"
 href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/static/css/sidebar.css">
    <link rel="stylesheet" href="/static/css/dashboard.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>

    <%- include('partials/sidebar') %>

    <div
        id="upload-container"
        class="container py-5"
    >

        <!-- ===================================== -->
        <!-- CABEÇALHO -->
        <!-- ===================================== -->

        <header
            id="upload-header"
            class="mb-4"
        >

            <h1
                id="upload-title"
                class="fw-bold"
            >
                Enviar arquivo
            </h1>

           <p
    id="upload-description"
    class="text-muted"
>
    Envie uma planilha para que o DataMind
    possa analisar seus dados.
</p>

<div
    id="setor-selecionado"
    class="alert alert-primary"
>

    <strong>Setor selecionado:</strong>

    <span id="setor-nome">

        <% if (setor === "rh") { %>
            RH
        <% } else if (setor === "financeiro") { %>
            Financeiro
        <% } else if (setor === "comercial") { %>
            Comercial
        <% } else if (setor === "personalizado") { %>
            Personalizado
        <% } %>

    </span>

    <a
        id="alterar-setor"
        href="/setor"
        class="ms-3"
    >
        Alterar setor
    </a>

</div>
        </header>


        <!-- ===================================== -->
        <!-- FORMULÁRIO -->
        <!-- ===================================== -->

        <section
            id="upload-section"
        >

            <div
                id="upload-card"
                class="card shadow-sm"
            >

                <div class="card-body p-4">

                    <form
                        id="upload-form"
                        action="/upload"
                        method="POST"
                        enctype="multipart/form-data"
                    >

                        <!-- CAMPO DE ARQUIVO -->

                        <div
                            id="arquivo-field"
                            class="mb-4"
                        >

                            <label
                                for="arquivo"
                                id="arquivo-label"
                                class="form-label fw-semibold"
                            >
                                Selecione seu arquivo
                            </label>

                            <input
                                type="file"
                                id="arquivo"
                                name="arquivo"
                                class="form-control"
                                accept=".xlsx,.xls,.csv"
                                required
                            >

                            <div
                                id="arquivo-help"
                                class="form-text"
                            >
                                Formatos permitidos:
                                XLSX, XLS e CSV.
                                Tamanho máximo: 10 MB.
                            </div>

                        </div>


                        <!-- NOME DO ARQUIVO -->

                        <div
                            id="arquivo-selecionado"
                            class="alert alert-secondary d-none"
                        >

                            <strong>
                                Arquivo selecionado:
                            </strong>

                            <span id="nome-arquivo">
                            </span>

                        </div>


                        <!-- MENSAGEM -->

                        <div
                            id="upload-mensagem"
                            class="d-none"
                            role="alert"
                        >
                        </div>


                        <!-- BOTÕES -->

                        <div
                            id="upload-actions"
                            class="d-flex gap-2"
                        >

                            <a
                                id="btn-voltar"
                                href="/dashboard"
                                class="btn btn-secondary"
                            >
                                Voltar
                            </a>

                            <button
                                type="submit"
                                id="btn-enviar"
                                class="btn btn-primary"
                            >
                                Enviar arquivo
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </section>

    </div>


    <!-- ===================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================== -->

    <script>

        const formulario =
            document.getElementById("upload-form");

        const arquivo =
            document.getElementById("arquivo");

        const nomeArquivo =
            document.getElementById("nome-arquivo");

        const arquivoSelecionado =
            document.getElementById("arquivo-selecionado");

        const mensagem =
            document.getElementById("upload-mensagem");

        const botaoEnviar =
            document.getElementById("btn-enviar");


        // ==========================================
        // MOSTRA O NOME DO ARQUIVO SELECIONADO
        // ==========================================

        arquivo.addEventListener(
            "change",
            () => {

                if (arquivo.files.length > 0) {

                    nomeArquivo.textContent =
                        arquivo.files[0].name;

                    arquivoSelecionado.classList.remove(
                        "d-none"
                    );

                } else {

                    arquivoSelecionado.classList.add(
                        "d-none"
                    );

                }

            }
        );


        // ==========================================
        // ENVIO DO ARQUIVO
        // ==========================================

        formulario.addEventListener(
            "submit",
            async (event) => {

                event.preventDefault();


                // Verifica se existe arquivo

                if (arquivo.files.length === 0) {

                    mostrarMensagem(
                        "Selecione um arquivo antes de enviar.",
                        "danger"
                    );

                    return;

                }


                // Desabilita botão

                botaoEnviar.disabled = true;

                botaoEnviar.textContent =
                    "Analisando arquivo...";


                mostrarMensagem(
                    "O arquivo está sendo enviado e analisado. Aguarde...",
                    "info"
                );


                try {

                    const dados =
                        new FormData(formulario);


                    const resposta =
                        await fetch(
                            "/upload",
                            {
                                method: "POST",
                                body: dados
                            }
                        );


                    const resultado =
                        await resposta.json();


                    // ==================================
                    // SUCESSO
                    // ==================================

                    if (
                        resposta.ok &&
                        resultado.sucesso
                    ) {

                        mostrarMensagem(
                            "Arquivo enviado e analisado com sucesso! Redirecionando...",
                            "success"
                        );


                        setTimeout(
                            () => {

                                window.location.href =
                                    "/dashboard";

                            },
                            1000
                        );


                        return;

                    }


                    // ==================================
                    // ERRO
                    // ==================================

                    mostrarMensagem(
                        resultado.erro ||
                        "Não foi possível analisar o arquivo.",
                        "danger"
                    );


                    botaoEnviar.disabled = false;

                    botaoEnviar.textContent =
                        "Enviar arquivo";


                } catch (erro) {

                    console.error(erro);


                    mostrarMensagem(
                        "Não foi possível obter uma resposta do servidor.",
                        "danger"
                    );


                    botaoEnviar.disabled = false;

                    botaoEnviar.textContent =
                        "Enviar arquivo";

                }

            }
        );


        // ==========================================
        // MOSTRAR MENSAGEM
        // ==========================================

        function mostrarMensagem(
            texto,
            tipo
        ) {

            mensagem.textContent =
                texto;

            mensagem.className =
                `alert alert-${tipo}`;

        }

    </script>


    <!-- Bootstrap JS -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

</body>

</html>