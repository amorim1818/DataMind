
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/css/style.css">
    <title>Login - DataMind</title>
</head>
<body class="pagina-auth">

    <main class="auth-container">

        <section class="painel-marca">
            <div class="marca">
                <h2>DATA</h2>
                <h2>MIND</h2>
                <p>Transformando dados em decisões inteligentes!</p>
            </div>
            <small class="rodape-marca">© DataMind 2026</small>
        </section>

        <section class="painel-formulario">
            <div class="formulario-conteudo">

                <header class="formulario-header">
                    <h1>Bem-vindo de volta!</h1>
                    <p>Faça login para acessar a sua conta</p>
                </header>

                <form action="/login" method="POST" class="form-auth">

                    <div class="campo">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="campo">
                        <label for="senha">Senha</label>
                        <input type="password" id="senha" name="senha" required>
                    </div>

                    <button class="botao-auth" type="submit">Entrar</button>
                </form>

                <p class="texto-alternativo">
                    Ainda não tem uma conta?
                    <a href="/cadastro">Cadastre-se</a>
                </p>

            </div>
        </section>

    </main>

</body>
</html>
