<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        DataMind - Histórico
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <link rel="stylesheet"
 href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/static/css/sidebar.css">
    <link rel="stylesheet" href="/static/css/dashboard.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>


<body>
    <%- include('partials/sidebar') %>


<div class="container py-5">


    <!-- CABEÇALHO -->

    <div
        class="d-flex
               justify-content-between
               align-items-center
               flex-wrap
               gap-3
               mb-4"
    >

        <div>

            <h1 class="fw-bold">
                Histórico de análises
            </h1>

            <p class="text-muted mb-0">

                Consulte suas análises
                realizadas anteriormente.

            </p>

        </div>


        <div class="d-flex gap-2">

            <a
                href="/dashboard"
                class="btn btn-outline-secondary"
            >
                Dashboard
            </a>


            <a
                href="/setor"
                class="btn btn-primary"
            >
                Nova análise
            </a>

        </div>

    </div>



    <!-- SEM HISTÓRICO -->

    <% if (historico.length === 0) { %>


        <div class="alert alert-info">

            Você ainda não possui
            análises salvas.

        </div>


    <% } else { %>


        <!-- TABELA -->

        <div class="card">

            <div class="card-body">


                <div class="table-responsive">


                    <table
                        class="table
                               table-hover
                               align-middle"
                    >


                        <thead>

                            <tr>

                                <th>
                                    Arquivo
                                </th>

                                <th>
                                    Setor
                                </th>

                                <th>
                                    Linhas
                                </th>

                                <th>
                                    Data
                                </th>

                                <th>
                                    Ação
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                        <% historico.forEach(
                            item => {
                        %>


                            <tr>


                                <!-- ARQUIVO -->

                                <td>

                                    <strong>
                                        <%= item.upload.nome_arquivo %>
                                    </strong>

                                </td>



                                <!-- SETOR -->

                                <td>

                                    <span
                                        class="badge text-bg-secondary"
                                    >

                                        <%= 
                                            item.resumo &&
                                            item.resumo.setor
                                                ? item.resumo.setor
                                                : "Personalizado"
                                        %>

                                    </span>

                                </td>



                                <!-- LINHAS -->

                                <td>

                                    <%= 
                                        item.resumo
                                            ? item.resumo.linhas
                                            : "-"
                                    %>

                                </td>



                                <!-- DATA -->

                                <td>

                                    <%= 
                                        new Date(
                                            item.analise.criado_em
                                        ).toLocaleString(
                                            "pt-BR"
                                        )
                                    %>

                                </td>



                                <!-- VISUALIZAR -->

                                <td>

                                    <a
                                        href="/analise/<%= item.upload.id %>"
                                        class="btn btn-sm btn-primary"
                                    >

                                        Visualizar

                                    </a>

                                </td>


                            </tr>


                        <% }) %>


                        </tbody>


                    </table>


                </div>

            </div>

        </div>


    <% } %>


</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>


</body>

</html>