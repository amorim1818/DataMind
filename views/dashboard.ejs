<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>DataMind - Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <link rel="stylesheet"
 href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/static/css/sidebar.css">
    <link rel="stylesheet" href="/static/css/dashboard.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

<%- include('partials/sidebar') %>

<div class="container py-5">

    <!-- CABEÇALHO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">
                Dashboard
            </h1>

            <p class="text-muted mb-0">
                Bem-vindo, <%= usuario.nome %>
            </p>
        </div>

      <div class="d-flex gap-2">

    <a
        href="/historico"
        class="btn btn-outline-primary"
    >
        Histórico
    </a>

    <a
        href="/setor"
        class="btn btn-primary"
    >
        Nova análise
    </a>

</div>

    </div>


    <!-- SEM ANÁLISE -->

    <% if (!analise) { %>

        <div class="alert alert-info">

            Nenhuma análise encontrada.

            <a href="/setor">
                Faça sua primeira análise.
            </a>

        </div>

    <% } else { %>


        <!-- ÚLTIMA ANÁLISE -->

        <div class="card mb-4">

            <div class="card-body">

                <h5>
                    Última análise
                </h5>

                <p class="mb-1">

                    <strong>
                        Arquivo:
                    </strong>

                    <%= analise.arquivo %>

                </p>

                <p class="mb-0">

                    <strong>
                        Setor:
                    </strong>

                    <%= analise.setor || "Personalizado" %>

                </p>

            </div>

        </div>


        <!-- INDICADORES -->

        <h3 class="mb-3">
            Informações da planilha
        </h3>

        <div class="row g-3 mb-5">


            <div class="col-md-3">

                <div class="card h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Linhas
                        </h6>

                        <h2>
                            <%= analise.linhas %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="card h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Colunas
                        </h6>

                        <h2>
                            <%= analise.colunas %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="card h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Valores vazios
                        </h6>

                        <h2>
                            <%= analise.valores_vazios %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="card h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Duplicados
                        </h6>

                        <h2>
                            <%= analise.duplicados %>
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================= -->
        <!-- GERADOR DE GRÁFICOS -->
        <!-- ================================= -->

        <div class="card mb-5">

            <div class="card-body">

                <h3>
                    Gerador de gráficos
                </h3>

                <p class="text-muted">

                    Escolha as informações da planilha
                    que deseja visualizar.

                </p>


                <div class="row g-3">


                    <!-- CATEGORIA -->

                    <div class="col-lg-3 col-md-6">

                        <label
                            for="colunaCategoria"
                            class="form-label"
                        >
                            Categoria
                        </label>

                        <select
                            id="colunaCategoria"
                            class="form-select"
                        >

                            <% analise.nome_colunas.forEach(
                                coluna => {
                            %>

                                <option value="<%= coluna %>">

                                    <%= coluna %>

                                </option>

                            <% }) %>

                        </select>

                    </div>


                    <!-- INDICADOR -->

                    <div class="col-lg-3 col-md-6">

                        <label
                            for="colunaValor"
                            class="form-label"
                        >
                            Indicador
                        </label>

                        <select
                            id="colunaValor"
                            class="form-select"
                        >

                            <% analise.colunas_numericas.forEach(
                                coluna => {
                            %>

                                <option value="<%= coluna %>">

                                    <%= coluna %>

                                </option>

                            <% }) %>

                        </select>

                    </div>


                    <!-- CÁLCULO -->

                    <div class="col-lg-3 col-md-6">

                        <label
                            for="tipoCalculo"
                            class="form-label"
                        >
                            Cálculo
                        </label>

                        <select
                            id="tipoCalculo"
                            class="form-select"
                        >

                            <option value="soma">
                                Soma
                            </option>

                            <option value="media">
                                Média
                            </option>

                            <option value="contagem">
                                Contagem
                            </option>

                            <option value="minimo">
                                Mínimo
                            </option>

                            <option value="maximo">
                                Máximo
                            </option>

                        </select>

                    </div>


                    <!-- TIPO DE GRÁFICO -->

                    <div class="col-lg-3 col-md-6">

                        <label
                            for="tipoGrafico"
                            class="form-label"
                        >
                            Tipo de gráfico
                        </label>

                        <select
                            id="tipoGrafico"
                            class="form-select"
                        >

                            <option value="bar">
                                Barras
                            </option>

                            <option value="line">
                                Linha
                            </option>

                            <option value="pie">
                                Pizza
                            </option>

                            <option value="doughnut">
                                Rosca
                            </option>

                        </select>

                    </div>

                </div>


                <!-- BOTÃO -->

                <div class="mt-3">

                    <button
                        type="button"
                        id="btnGerarGrafico"
                        class="btn btn-primary"
                    >
                        Gerar gráfico
                    </button>

                </div>


                <!-- MENSAGEM DE ERRO -->

                <div
                    id="mensagemGrafico"
                    class="alert alert-warning mt-3 d-none"
                >
                </div>


                <!-- GRÁFICO -->

                <div
                    class="mt-4"
                    style="height: 450px;"
                >

                    <canvas
                        id="graficoDinamico"
                    ></canvas>

                </div>

            </div>

        </div>

<!-- ================================= -->
<!-- INSIGHTS DA INTELIGÊNCIA ARTIFICIAL -->
<!-- ================================= -->

<div class="card mb-5">

    <div class="card-body">

        <div
            class="d-flex align-items-center
                   justify-content-between
                   flex-wrap gap-2 mb-3"
        >

            <div>

                <h3 class="mb-1">
                    ✨ Insights da IA
                </h3>

                <p class="text-muted mb-0">
                    Análise inteligente dos dados
                    realizada pelo DataMind.
                </p>

            </div>

            <span class="badge text-bg-primary">
                Gemini
            </span>

        </div>


        <% if (respostaIa) { %>

            <div
                id="resposta-ia"
                class="p-3 bg-light rounded"
                style="white-space: pre-line;"
            ><%= respostaIa %></div>

        <% } else { %>

            <div class="alert alert-warning mb-0">

                Não foi possível gerar os insights
                desta análise.

            </div>

        <% } %>

    </div>

</div>
        <!-- ================================= -->
        <!-- ESTATÍSTICAS -->
        <!-- ================================= -->

        <div class="card mb-5">

            <div class="card-body">

                <h3 class="mb-4">
                    Estatísticas numéricas
                </h3>


                <% if (
                    Object.keys(
                        analise.estatisticas
                    ).length === 0
                ) { %>

                    <p class="text-muted">
                        Nenhuma coluna numérica encontrada.
                    </p>

                <% } else { %>


                    <div class="table-responsive">

                        <table class="table table-striped">

                            <thead>

                                <tr>

                                    <th>Coluna</th>
                                    <th>Soma</th>
                                    <th>Média</th>
                                    <th>Mínimo</th>
                                    <th>Máximo</th>
                                    <th>Mediana</th>

                                </tr>

                            </thead>


                            <tbody>

                                <% Object.keys(
                                    analise.estatisticas
                                ).forEach(
                                    coluna => {

                                    const estatistica =
                                        analise.estatisticas[
                                            coluna
                                        ];
                                %>

                                    <tr>

                                        <td>
                                            <strong>
                                                <%= coluna %>
                                            </strong>
                                        </td>

                                        <td>
                                            <%= estatistica.soma %>
                                        </td>

                                        <td>
                                            <%= estatistica.media %>
                                        </td>

                                        <td>
                                            <%= estatistica.minimo %>
                                        </td>

                                        <td>
                                            <%= estatistica.maximo %>
                                        </td>

                                        <td>
                                            <%= estatistica.mediana %>
                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                <% } %>

            </div>

        </div>


        <!-- COLUNAS -->

        <div class="card">

            <div class="card-body">

                <h3>
                    Colunas identificadas
                </h3>

                <p class="text-muted">
                    Colunas encontradas automaticamente
                    pelo DataMind.
                </p>


                <% analise.nome_colunas.forEach(
                    coluna => {
                %>

                    <span
                        class="badge text-bg-secondary me-2 mb-2"
                    >

                        <%= coluna %>

                    </span>

                <% }) %>

            </div>

        </div>


    <% } %>

</div>


<!-- ================================= -->
<!-- JAVASCRIPT -->
<!-- ================================= -->

<% if (analise) { %>

<script>

    /*
        Dados enviados pelo Python
        e armazenados na análise.
    */

    const dadosPlanilha =
        <%- JSON.stringify(
            analise.dados || []
        ) %>;


    const colunaCategoria =
        document.getElementById(
            "colunaCategoria"
        );


    const colunaValor =
        document.getElementById(
            "colunaValor"
        );


    const tipoCalculo =
        document.getElementById(
            "tipoCalculo"
        );


    const tipoGrafico =
        document.getElementById(
            "tipoGrafico"
        );


    const botaoGerar =
        document.getElementById(
            "btnGerarGrafico"
        );


    const mensagemGrafico =
        document.getElementById(
            "mensagemGrafico"
        );


    let graficoAtual = null;


    /*
        =================================
        FUNÇÃO PRINCIPAL
        =================================
    */

    function gerarGrafico() {

        esconderMensagem();


        const categoria =
            colunaCategoria.value;


        const indicador =
            colunaValor.value;


        const calculo =
            tipoCalculo.value;


        const tipo =
            tipoGrafico.value;


        if (!categoria || !indicador) {

            mostrarMensagem(
                "Selecione uma categoria e um indicador."
            );

            return;

        }


        /*
            Objeto usado para agrupar
            os registros da planilha.

            Exemplo:

            Comercial:
            [15000, 22000, 18500...]

            RH:
            [9000, 7500...]
        */

        const grupos = {};


        dadosPlanilha.forEach(
            linha => {

                let nomeCategoria =
                    linha[categoria];


                const valor =
                    Number(
                        linha[indicador]
                    );


                if (
                    nomeCategoria === null ||
                    nomeCategoria === undefined ||
                    nomeCategoria === ""
                ) {

                    nomeCategoria =
                        "Não informado";

                }


                /*
                    Para soma, média,
                    mínimo e máximo,
                    precisamos de número.
                */

                if (
                    calculo !== "contagem" &&
                    Number.isNaN(valor)
                ) {

                    return;

                }


                if (!grupos[nomeCategoria]) {

                    grupos[nomeCategoria] = [];

                }


                /*
                    Contagem não precisa
                    realmente do valor.
                */

                if (calculo === "contagem") {

                    grupos[nomeCategoria].push(1);

                } else {

                    grupos[nomeCategoria].push(
                        valor
                    );

                }

            }
        );


        const labels =
            Object.keys(grupos);


        if (labels.length === 0) {

            mostrarMensagem(
                "Não existem dados suficientes para gerar este gráfico."
            );

            return;

        }


        /*
            Calcula o resultado
            de cada categoria.
        */

        const valores =
            labels.map(
                nomeCategoria => {

                    const valoresGrupo =
                        grupos[nomeCategoria];


                    /*
                        SOMA
                    */

                    if (calculo === "soma") {

                        return valoresGrupo.reduce(
                            (total, numero) =>
                                total + numero,
                            0
                        );

                    }


                    /*
                        MÉDIA
                    */

                    if (calculo === "media") {

                        const soma =
                            valoresGrupo.reduce(
                                (total, numero) =>
                                    total + numero,
                                0
                            );


                        return Number(
                            (
                                soma /
                                valoresGrupo.length
                            ).toFixed(2)
                        );

                    }


                    /*
                        CONTAGEM
                    */

                    if (
                        calculo === "contagem"
                    ) {

                        return valoresGrupo.length;

                    }


                    /*
                        MÍNIMO
                    */

                    if (
                        calculo === "minimo"
                    ) {

                        return Math.min(
                            ...valoresGrupo
                        );

                    }


                    /*
                        MÁXIMO
                    */

                    if (
                        calculo === "maximo"
                    ) {

                        return Math.max(
                            ...valoresGrupo
                        );

                    }


                    return 0;

                }
            );


        /*
            Remove gráfico anterior
            antes de gerar um novo.
        */

        if (graficoAtual) {

            graficoAtual.destroy();

        }


        /*
            Nome amigável do cálculo.
        */

        const nomesCalculo = {

            soma:
                "Soma",

            media:
                "Média",

            contagem:
                "Contagem",

            minimo:
                "Mínimo",

            maximo:
                "Máximo"

        };


        const nomeCalculo =
            nomesCalculo[calculo];


        /*
            Criação do gráfico.
        */

        const canvas =
            document.getElementById(
                "graficoDinamico"
            );


        graficoAtual =
            new Chart(
                canvas,
                {

                    type:
                        tipo,


                    data: {

                        labels:
                            labels,


                        datasets: [
                            {
                                label:
                                    `${nomeCalculo} de ${indicador}`,

                                data:
                                    valores,

                                borderWidth:
                                    2
                            }

                        ]

                    },

                    options: {

                        responsive:
                            true,


                        maintainAspectRatio:
                            false,


                        plugins: {

                            title: {

                                display:
                                    true,

                                text:
                                    `${nomeCalculo} de ${indicador} por ${categoria}`

                            },


                            legend: {

                                display:
                                    true

                            }

                        },


                        scales:

                            tipo === "pie" ||
                            tipo === "doughnut"

                                ? {}

                                : {

                                    y: {

                                        beginAtZero:
                                            true

                                    }

                                }

                    }

                }
            );

    }


    /*
        =================================
        MENSAGENS
        =================================
    */

    function mostrarMensagem(texto) {

        mensagemGrafico.textContent =
            texto;


        mensagemGrafico.classList.remove(
            "d-none"
        );

    }


    function esconderMensagem() {

        mensagemGrafico.classList.add(
            "d-none"
        );

    }


    /*
        =================================
        EVENTO DO BOTÃO
        =================================
    */

    botaoGerar.addEventListener(
        "click",
        gerarGrafico
    );


    /*
        Gera o primeiro gráfico
        automaticamente.
    */

    if (
        dadosPlanilha.length > 0 &&
        colunaValor.options.length > 0
    ) {

        gerarGrafico();

    }

</script>

<% } %>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

</body>

</html>